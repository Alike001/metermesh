{
  "name": "@metermesh/db",
  "version": "0.1.0",
  "private": true,
  "description": "Durable PostgreSQL state and outbox for MeterMesh.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@metermesh/protocol": "workspace:*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "viem": "2.55.19"
  }
}

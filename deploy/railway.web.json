{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @metermesh/web build",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/ai/**",
      "/packages/chain/**",
      "/packages/protocol/**",
      "/packages/xmtp/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyMaxRetries": 10,
    "restartPolicyType": "ON_FAILURE",
    "startCommand": "pnpm --filter @metermesh/web start"
  }
}

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @metermesh/worker... build",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/ai/**",
      "/packages/chain/**",
      "/packages/db/**",
      "/packages/protocol/**",
      "/packages/xmtp/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 180,
    "restartPolicyMaxRetries": 10,
    "restartPolicyType": "ON_FAILURE",
    "startCommand": "pnpm --filter @metermesh/worker start"
  }
}
